# ========================================
# Vercel & Next.js 项目完整 .gitignore
# ========================================

# === 依赖目录 ===
node_modules/
.pnpm-store/

# === 构建输出 ===
.next/
out/
build/
dist/

# === 环境变量（绝不能上传！）===
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# === IDE / 编辑器 ===
.vscode/
.idea/
*.swp
*.swo
*~

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === Vercel 特定 ===
.vercel/
.snowflake/
.v0-trash/

# === v0 开发工具（内部使用）===
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
next.user-config.*

# === 日志与调试 ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === 临时文件 ===
*.tmp
*.temp
.cache/
.temp/

# === TypeScript ===
*.tsbuildinfo
next-env.d.ts

# === 测试覆盖率 ===
coverage/
.nyc_output/
