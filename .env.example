# ========================================
# 环境变量示例文件（用于部署参考）
# ========================================
# 
# ⚠️ 重要提示：
# 1. 复制此文件为 .env.local 用于本地开发
# 2. 不要将包含真实 API Key 的 .env.local 上传到 GitHub
# 3. 在 Vercel 部署时，需要在 Settings → Environment Variables 中配置
#
# ========================================

# --- 火山引擎 DeepSeek API 配置 ---
# 获取地址：https://console.volcengine.com/
VOLC_ACCESS_KEY=your_volc_access_key_here
VOLC_MODEL_ID=your_volc_model_id_here

# --- Dify API 配置 ---
# 获取地址：https://cloud.dify.ai/ 或自托管 Dify 实例
DIFY=your_dify_api_key_here

# ========================================
# 本地开发使用方法：
# 1. cp .env.example .env.local
# 2. 编辑 .env.local，填入真实值
# 3. pnpm dev
# ========================================
